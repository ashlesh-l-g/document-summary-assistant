# AI Provider Selection
# Options: nvidia | gemini
AI_PROVIDER=nvidia

# NVIDIA NIM Configuration (Required if AI_PROVIDER=nvidia)
# https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini Configuration (Required if AI_PROVIDER=gemini)
# https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
